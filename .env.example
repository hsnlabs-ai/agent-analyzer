# Agent Analyzer — Standalone Configuration Template
# Official Product Page: https://hsnlabs.ai/en/products/agent-analyzer/
# Repository: https://github.com/hsnlabs-ai/agent-analyzer

# FastAPI Backend Bind Settings (Default :8095 to coexist with agents-swarm :8090)
ANALYZER_HOST=127.0.0.1
ANALYZER_PORT=8095
ANALYZER_DB_PATH=data/analyzer.sqlite3

# WAHA Single-Session WhatsApp Web Bridge (Default :3001)
WAHA_BASE_URL=http://localhost:3001
WAHA_SESSION_NAME=default
WAHA_API_KEY=

# Optional LLM Provider for Dynamic Probe Synthesis
# Falls back to deterministic 6-wave PT-BR/EN probe catalog when unset
ANALYZER_LLM_PROVIDER=gemini
ANALYZER_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Pacing & Anti-Ban Jitter Floors
ANALYZER_SIM_JITTER_SCALE=0.08
ANALYZER_LIVE_JITTER_SCALE=0.35
ANALYZER_MIN_TURN_GAP_S=2.0
